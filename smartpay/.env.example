# SmartPay Frontend Environment Variables
# Copy to .env and fill in your values
# Location: fintech/smartpay/.env.example

# API Configuration (align with fintech/apps/smartpay-mobile/.env.example)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
# Copilot: prefer backend proxy at /api/v1/copilot/chat (see smartpay-mobile .env.example)
EXPO_PUBLIC_COPILOT_API_URL=http://localhost:4000

# Authentication: Supabase (Buffr Connect project) + backend OTP.
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=  # Unused

# Sandbox / local development
# Set to "1" to bypass auth gating. DO NOT use in production builds.
EXPO_PUBLIC_SKIP_AUTH=0

# Feature Flags
EXPO_PUBLIC_ENABLE_OBS=true
EXPO_PUBLIC_ENABLE_LOANS=true
EXPO_PUBLIC_ENABLE_GROUPS=true
EXPO_PUBLIC_ENABLE_PROOF_OF_LIFE=true

# Analytics (Optional)
EXPO_PUBLIC_ANALYTICS_ID=
EXPO_PUBLIC_SENTRY_DSN=

# Development Settings
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_MOCK_API=false

# Supabase (Buffr Connect project; same user for Smartpay + Ketchup)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Canonical test user – MUST match buffr-connect/buffrconnect/.env.test for same identity
# Use for E2E, OBS consent, and bank account access via Buffr Connect
TEST_USER_EMAIL=
TEST_USER_PASSWORD=

# Onboarding simulation (mobile): pre-fills phone and name in dev; OTP 123456 for test number or when API down
# Set in mobile/.env with EXPO_PUBLIC_ prefix so the app can read them
EXPO_PUBLIC_TEST_USER_PHONE=
EXPO_PUBLIC_TEST_USER_FIRST_NAME=
EXPO_PUBLIC_TEST_USER_LAST_NAME=
