# Buffr Connect deployment origin (no trailing slash). Naming map: ketchup-portals/docs/DOMAIN_AND_ENV_RECOMMENDATIONS.md
EXPO_PUBLIC_BUFFR_BASE_URL=http://localhost:3000

# OAuth client registered in Buffr Connect (dashboard / developer settings)
EXPO_PUBLIC_BUFFR_CLIENT_ID=your-client-id

# Must match the redirect you registered; expo scheme buffrfintech → buffrfintech://oauth
EXPO_PUBLIC_OAUTH_REDIRECT_URI=buffrfintech://oauth

# Optional: your backend that exchanges the auth code (Buffr /api/oidc/token often requires an existing session)
EXPO_PUBLIC_TOKEN_BRIDGE_URL=https://your-api.example.com/api/buffr/oauth/token

# Dev-only bypass: paste a Bearer JWT from a logged-in Buffr session (never ship to production)
# EXPO_PUBLIC_DEV_ACCESS_TOKEN=
