{
  "name": "buffr-g2p-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:check": "node scripts/check-db.mjs",
    "db:schema": "node scripts/db-schema.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "db:clear-and-seed": "node scripts/clear-and-seed.mjs",
    "fineract:check": "node scripts/check-fineract.mjs",
    "dev": "nodemon --watch src --ext ts,mjs,js --exec 'npm run build && node dist/server.js'",
    "start": "node dist/server.js",
    "build": "tsc",
    "migrate": "node scripts/run-migrations.mjs",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "morgan": "^1.10.1",
    "pg": "^8.13.0",
    "twilio": "^5.4.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.35",
    "@types/pg": "^8.18.0",
    "@types/twilio": "^3.19.2",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
