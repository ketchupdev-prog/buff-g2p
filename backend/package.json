{
  "name": "buffr-g2p-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:check": "node scripts/check-db.mjs",
    "db:schema": "node scripts/db-schema.mjs",
    "db:seed": "node scripts/seed-db.mjs",
    "db:clear-and-seed": "node scripts/clear-and-seed.mjs",
    "fineract:check": "node scripts/check-fineract.mjs",
    "dev": "nodemon --watch src --ext ts,mjs,js --exec 'npm run build && node dist/server.js'",
    "start": "node dist/server.js",
    "build": "tsc",
    "migrate": "node scripts/run-migrations.mjs",
    "type-check": "tsc --noEmit",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:verify-ai": "PYTHONPATH=. python scripts/verify_buffr_ai.py",
    "test:ai-unit": "PYTHONPATH=. python -m unittest discover -s buffr_ai/tests -p 'test_*.py' -v"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.1",
    "morgan": "^1.10.1",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.0",
    "twilio": "^5.4.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.35",
    "@types/pg": "^8.18.0",
    "@types/twilio": "^3.19.2",
    "jest": "^30.2.0",
    "nodemon": "^3.1.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}
