# Buffr AI Companion – copy into backend/.env or set in environment.
# See also backend/.env.example for DATABASE_URL and other backend vars.

# LLM (Companion and analyst agents)
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o

# Optional: DeepSeek
# LLM_PROVIDER=deepseek
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Postgres (checkpointer + optional DB pool for agents)
# For Neon: use the pooled connection string (e.g. ...@ep-xxx-pooler....neon.tech/...) and ?sslmode=require
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# BUFFR_CHECKPOINT_DATABASE_URL=...  # optional override for checkpointer

# Buffr backend API (for execute_tool_node in production)
BUFFR_API_URL=https://api.buffr.na
BUFFR_API_KEY=...
# Companion: Node backend URL for user profile (GET /api/v1/mobile/user/profile). e.g. http://localhost:3001
BUFFR_API_BASE_URL=http://localhost:3001

# Optional: model artifacts (ML)
# MODEL_DIR=./models
# JWT_SECRET=your-secret
