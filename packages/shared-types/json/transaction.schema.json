{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartpay.na/schemas/transaction.json",
  "title": "Transaction",
  "description": "SmartPay transaction record",
  "type": "object",
  "required": ["id", "wallet_id", "type", "amount", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique transaction identifier"
    },
    "wallet_id": {
      "type": "string",
      "format": "uuid",
      "description": "Wallet involved in transaction"
    },
    "type": {
      "type": "string",
      "enum": [
        "voucher_redeem",
        "send",
        "receive",
        "cash_out",
        "bill_pay",
        "airtime",
        "loan_disbursement",
        "loan_repayment",
        "add_money",
        "group_contribution",
        "group_withdrawal",
        "transfer_out",
        "transfer_in",
        "payment",
        "redemption",
        "fee",
        "load",
        "refund"
      ],
      "description": "Transaction type"
    },
    "amount": {
      "type": "number",
      "minimum": 0,
      "description": "Transaction amount"
    },
    "balance_after": {
      "type": "number",
      "description": "Account balance after transaction"
    },
    "reference_type": {
      "type": "string",
      "description": "Type of reference (e.g., invoice, order)"
    },
    "reference_id": {
      "type": "string",
      "description": "External reference identifier"
    },
    "reference": {
      "type": "string",
      "description": "Human-readable reference"
    },
    "description": {
      "type": "string",
      "description": "Transaction description"
    },
    "status": {
      "type": "string",
      "enum": ["success", "pending", "failed", "completed"],
      "description": "Transaction status"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Transaction timestamp"
    }
  }
}
