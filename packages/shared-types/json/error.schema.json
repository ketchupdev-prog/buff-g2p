{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://smartpay.na/schemas/error.json",
  "title": "Error",
  "description": "Standard error types for SmartPay APIs",
  "definitions": {
    "ApiError": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "VALIDATION_ERROR",
            "NOT_FOUND",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "CONFLICT",
            "INSUFFICIENT_FUNDS",
            "RATE_LIMIT_EXCEEDED",
            "INTERNAL_ERROR",
            "SERVICE_UNAVAILABLE",
            "BAD_REQUEST",
            "TIMEOUT",
            "COMPLIANCE_VIOLATION"
          ],
          "description": "Error code"
        },
        "message": {
          "type": "string",
          "description": "Human-readable error message"
        },
        "details": {
          "type": "object",
          "description": "Additional error details"
        },
        "field": {
          "type": "string",
          "description": "Field that caused the error (for validation errors)"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time",
          "description": "Error timestamp"
        }
      }
    },
    "ValidationError": {
      "type": "object",
      "required": ["code", "message", "field"],
      "properties": {
        "code": {
          "type": "string",
          "const": "VALIDATION_ERROR",
          "description": "Validation error code"
        },
        "message": {
          "type": "string",
          "description": "Validation error message"
        },
        "field": {
          "type": "string",
          "description": "Field that failed validation"
        },
        "constraint": {
          "type": "string",
          "description": "Validation constraint that was violated"
        }
      }
    },
    "ErrorResponse": {
      "type": "object",
      "required": ["success", "error"],
      "properties": {
        "success": {
          "type": "boolean",
          "const": false,
          "description": "Always false for error responses"
        },
        "error": {
          "$ref": "#/definitions/ApiError"
        }
      }
    }
  }
}
