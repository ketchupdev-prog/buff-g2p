# ═══════════════════════════════════════════════════════════════
# Smartpay AI Copilot - Environment Variables
# ═══════════════════════════════════════════════════════════════
# Ecosystem ports/names: ../../ketchup-smartpay/ketchup-portals/docs/DOMAIN_AND_ENV_RECOMMENDATIONS.md

# ─── Database (Neon PostgreSQL) ───
# Required for LangGraph checkpointer and conversation history
DATABASE_URL=postgresql://user:pass@ep-cool-breeze-123456.us-east-2.aws.neon.tech/smartpay?sslmode=require

# Optional: Separate database for checkpointer if needed
# SMARTPAY_CHECKPOINT_DATABASE_URL=

# ─── Node.js Backend API (Single Source of Truth for User Data - DRY) ───
# The Smartpay Node.js backend URL (used to fetch user profile and execute actions)
SMARTPAY_API_BASE_URL=http://localhost:4000

# ─── LLM Provider Configuration ───
# Provider values (smartpay_ai.providers): "openai" | "anthropic" | "gemini" | "deepseek"
# Google Generative AI: use LLM_PROVIDER=gemini (not "google").
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# Shared API key for the active provider (OpenAI, Anthropic, Gemini, DeepSeek, etc.).
# If unset, DEEPSEEK_API_KEY is used (handy when LLM_PROVIDER=deepseek).
LLM_API_KEY=
# DEEPSEEK_API_KEY=sk-...

# ─── ML Service (Optional) ───
# Set to "true" to enable ML models (fraud detection, credit scoring, spending analysis, etc.)
ML_ENABLED=false

# Path to trained models (default: ./smartpay_ai/models/)
# ML_MODELS_PATH=

# ─── FastAPI Server ───
# Port for the FastAPI server
PORT=8000

# Environment: "development" | "staging" | "production"
ENVIRONMENT=development

# ─── Logging ───
LOG_LEVEL=INFO

# ─── Vector Database (LanceDB) ───
# Path to LanceDB vector database for semantic knowledge base search
LANCEDB_PATH=./data/lancedb

# ─── Analytics Database (DuckDB) ───
# Path to DuckDB database for fast transaction analytics and ML training data
DUCKDB_PATH=./data/analytics.duckdb

# ─── Vector Embeddings (Open-Source) ───
# Uses BAAI/bge-m3 open-source embeddings (1024 dimensions)
# No API key needed - model runs locally (first run downloads ~2GB model)
BGE_M3_MODEL_NAME=BAAI/bge-m3

# ─── CORS (React Native Mobile App) ───
# Comma-separated list of allowed origins (use * for dev, restrict in production)
ALLOWED_ORIGINS=http://localhost:8081,exp://localhost:8081
