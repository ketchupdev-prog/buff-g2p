# Integration Test Environment Variables
# Location: fintech/smartpay-mobile/.env.test

# Backend Configuration
TEST_BACKEND_URL=http://localhost:4000
TEST_BACKEND_PORT=4000
# Expo / Jest: SmartPay REST API origin (no trailing path; all routes use /api/v1/... on this host)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
NODE_ENV=test

# Database Configuration (use separate test database to avoid polluting dev data)
TEST_DATABASE_URL=postgresql://localhost:5432/smartpay_test
DATABASE_URL=postgresql://localhost:5432/smartpay_test

# JWT Configuration
JWT_SECRET=test-jwt-secret-key-for-integration-tests
JWT_EXPIRY=1h
REFRESH_TOKEN_EXPIRY=7d

# Webhook Configuration
BUFFR_WEBHOOK_SECRET=test-webhook-secret-hmac-key-12345

# Ketchup Portals Configuration
KETCHUP_PORTALS_URL=http://localhost:3000
KETCHUP_API_KEY=test-ketchup-api-key

# OTP Configuration (test mode - use fixed codes)
OTP_TEST_MODE=true
OTP_TEST_CODE=123456

# Rate Limiting (relaxed for tests)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# Redis Configuration (optional for tests)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Supabase Configuration (for auth if needed)
EXPO_PUBLIC_SUPABASE_URL=https://test-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=test-supabase-anon-key

# Buffr Connect Configuration
EXPO_PUBLIC_BUFFR_CONNECT_URL=http://localhost:3000

# Feature Flags
EXPO_PUBLIC_ENABLE_BIOMETRICS=false
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=false

# Test User Configuration
EXPO_PUBLIC_TEST_USER_PHONE=+264811234567
EXPO_PUBLIC_TEST_USER_FIRST_NAME=Test
EXPO_PUBLIC_TEST_USER_LAST_NAME=User

# Logging
LOG_LEVEL=error
ENABLE_QUERY_LOGGING=false

# Security (relaxed for tests)
ENABLE_2FA=false
ENABLE_SIGNATURE_VALIDATION=true

# Push Notifications (disabled for tests)
EXPO_PUBLIC_EAS_PROJECT_ID=test-project-id
ENABLE_PUSH_NOTIFICATIONS=false

# App Configuration
APP_NAME=SmartPay Test
APP_VERSION=1.0.0-test
APP_ENV=test
