# Use Supabase credentials from buffrconnect
# Source: buffr-connect/buffrconnect/.env.local → NEXT_PUBLIC_SUPABASE_URL, NEXT_PUBLIC_SUPABASE_ANON_KEY
# Ecosystem env map: ketchup-portals/docs/DOMAIN_AND_ENV_RECOMMENDATIONS.md
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Buffr Connect app origin only (no /api) — same host as BUFFR_CONNECT_URL on the backend
EXPO_PUBLIC_BUFFR_CONNECT_URL=http://localhost:3000

# API Configuration — SmartPay backend (Express, default PORT=4000); paths include /api/v1/...
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000

# Copilot chat base URL (optional):
# - Default: requests use EXPO_PUBLIC_API_BASE_URL + /api/v1/copilot/chat (SmartPay backend / proxy).
# - Set EXPO_PUBLIC_COPILOT_API_URL to the same host as your API proxy (e.g. http://localhost:4000) when the
#   app must target a different origin than EXPO_PUBLIC_API_BASE_URL. Path is always /api/v1/copilot/chat.
# - For a separate direct AI stack, point this at that gateway only if it exposes the same chat route; otherwise
#   prefer proxying through the SmartPay backend and keep EXPO_PUBLIC_AI_API_BASE_URL for server-side use.
EXPO_PUBLIC_COPILOT_API_URL=http://localhost:4000
EXPO_PUBLIC_AI_API_BASE_URL=http://localhost:8000

# App Info
APP_NAME=SmartPay
APP_VERSION=1.0.0
APP_ENV=development

# Features
EXPO_PUBLIC_ENABLE_BIOMETRICS=true
EXPO_PUBLIC_ENABLE_OFFLINE_MODE=true

# Payment Provider (if applicable)
EXPO_PUBLIC_PAYMENT_PROVIDER_URL=
EXPO_PUBLIC_PAYMENT_PROVIDER_KEY=

# Onboarding simulation: pre-fills phone and name in dev; OTP is always 123456 for test number (or when API unavailable)
EXPO_PUBLIC_TEST_USER_PHONE=
EXPO_PUBLIC_TEST_USER_FIRST_NAME=
EXPO_PUBLIC_TEST_USER_LAST_NAME=

# Push Notifications
# Get your project ID from https://expo.dev
EXPO_PUBLIC_EAS_PROJECT_ID=
