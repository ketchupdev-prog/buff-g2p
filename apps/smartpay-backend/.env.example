# SmartPay Backend - Environment Variables
# Copy this file to .env and update with your values
#
# Cross-repo alignment: ../../ketchup-smartpay/ketchup-portals/docs/DOMAIN_AND_ENV_RECOMMENDATIONS.md
# Buffr: BUFFR_CONNECT_URL = origin only (no /api). BUFFR_API_URL = API base for BuffrClient (usually .../api).

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
NODE_ENV=development
PORT=4000
ALLOW_DEV_FALLBACK=true

# ============================================================================
# DATABASE CONFIGURATION (Neon PostgreSQL)
# ============================================================================
DATABASE_URL=postgresql://username:password@ep-xxx.us-east-2.aws.neon.tech/smartpay?sslmode=require

# ============================================================================
# SUPABASE
# ============================================================================
# Use Supabase credentials from buffrconnect
# Source: buffr-connect/buffrconnect/.env.local → SUPABASE_URL/NEXT_PUBLIC_SUPABASE_URL, SUPABASE_ANON_KEY/NEXT_PUBLIC_SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Buffr Connect Next.js origin ONLY (buffrConnectClient appends /api/health, etc.)
BUFFR_CONNECT_URL=http://localhost:3000

# ============================================================================
# JWT SECRETS
# ============================================================================
# IMPORTANT: Generate strong secrets for production
# Use: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production

# ============================================================================
# AUTHENTICATION
# ============================================================================
# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_DAILY_LIMIT=100

# ============================================================================
# SMS PROVIDER (Twilio)
# ============================================================================
# Get credentials from: https://console.twilio.com/
# Cost: ~$0.01-0.05 per SMS (varies by country)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ============================================================================
# EMAIL PROVIDER
# ============================================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@smartpay.com
SMTP_FROM_NAME=SmartPay

# SendGrid (Production Email - Recommended)
# Get API key from: https://app.sendgrid.com/settings/api_keys
# Free tier: 100 emails/day, Paid: From $19.95/month
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@smartpay.na
SENDGRID_FROM_NAME=SmartPay

# ============================================================================
# TRANSACTION LIMITS
# ============================================================================
DAILY_SEND_LIMIT_NAD=20000
DAILY_CASH_OUT_LIMIT_NAD=10000
DAILY_LOAN_LIMIT_NAD=5000

# ============================================================================
# BUFFR INTEGRATION
# ============================================================================
BUFFR_API_URL=http://localhost:3000/api
BUFFR_API_KEY=

# ============================================================================
# FINERACT INTEGRATION (Optional)
# ============================================================================
FINERACT_ENABLED=false
FINERACT_BASE_URL=
FINERACT_TENANT=default
FINERACT_USERNAME=
FINERACT_PASSWORD=
FINERACT_DEFAULT_OFFICE_ID=1
FINERACT_SAVINGS_PRODUCT_ID=1
FINERACT_LOAN_PRODUCT_ID=1

# ============================================================================
# OPEN BANKING (Optional)
# ============================================================================
OPEN_BANKING_ENABLED=false
OPEN_BANKING_CLIENT_ID=
OPEN_BANKING_CLIENT_SECRET=
OPEN_BANKING_REDIRECT_URI=
OPEN_BANKING_CERT_PATH=
OPEN_BANKING_KEY_PATH=

# ============================================================================
# AI/ML SERVICES (Optional)
# ============================================================================
# AI service for copilot chat proxy
# Node POST /api/v1/copilot/chat forwards to ${AI_SERVICE_URL}/api/v1/copilot/chat (see src/routes/copilotProxy.ts).
AI_SERVICE_URL=http://localhost:8000
# Set true when the AI service is up (e.g. local FastAPI on port 8000); used for ops/docs alignment with copilot proxy.
AI_SERVICE_ENABLED=true

# KYC LIVENESS RECOGNITION SERVICE (OpenCV/MediaPipe)
# Used by POST /api/v1/kyc/upload-documents to validate selfie video liveness.
KETCHUP_LIVENESS_SERVICE_URL=http://localhost:8002
# Using DeepSeek as primary LLM provider (not OpenAI)
# DEEPSEEK_API_KEY=

# ============================================================================
# LANCEDB & DUCKDB (Optional - for RAG)
# ============================================================================
LANCEDB_PATH=./data/lancedb
DUCKDB_PATH=./data/analytics.duckdb

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================================
# CORS CONFIGURATION
# ============================================================================
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# CLERK AUTHENTICATION (Optional)
# ============================================================================
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ============================================================================
# BON (BANK OF NAMIBIA) REPORTING
# ============================================================================
# Production: https://nps.bon.org.na/api
# Sandbox: https://sandbox-nps.bon.org.na/api (if available)
BON_API_BASE_URL=https://nps.bon.org.na/api
BON_API_KEY=
BON_REPORTING_ENABLED=false
# Optional: Mutual TLS certificate paths (if required by BoN)
# BON_CERTIFICATE_PATH=/path/to/client-cert.pem
# BON_PRIVATE_KEY_PATH=/path/to/client-key.pem

# ============================================================================
# WEBHOOK CONFIGURATION
# ============================================================================
# HMAC for Buffr → SmartPay webhooks (same *value* as Buffr Connect WEBHOOK_SECRET when using one integration)
# Generate with: openssl rand -hex 32
BUFFR_WEBHOOK_SECRET=

# ============================================================================
# PII ENCRYPTION (PSD-12 §11 Compliance - LICENSE REQUIREMENT)
# ============================================================================
# CRITICAL: These keys are REQUIRED for PSD-12 compliance
# PSD-12 Section 11 mandates ALL PII must be encrypted/tokenized/masked
# Missing these keys will block license approval
#
# Generate keys with: openssl rand -base64 32
# Each key should be unique and stored securely (use secrets manager in production)
#
PII_ENCRYPTION_KEY=<generate-with-openssl-rand-base64-32>
PII_PHONE_KEY=<generate-with-openssl-rand-base64-32>
PII_EMAIL_KEY=<generate-with-openssl-rand-base64-32>
PII_WALLET_KEY=<generate-with-openssl-rand-base64-32>
#
# Example (DO NOT USE THESE IN PRODUCTION):
# PII_ENCRYPTION_KEY=ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/==
# PII_PHONE_KEY=XYZABCDEFGHIJKLMNOPQRSTUVWabcdefghijklmnopqrstuvwxyz0123456789+/==
# PII_EMAIL_KEY=123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz+/==
# PII_WALLET_KEY=abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ+/==
#
# Key rotation: Rotate keys every 90 days
# Backup: Store keys in secure backup location (HSM recommended for production)

# ============================================================================
# COMPLIANCE AUTOMATION (PSD-3 & PSD-12)
# ============================================================================
# BoN: reporting-client uses BON_API_BASE_URL + BON_API_KEY (see above).
# incidentReporter uses BON_API_URL if set (defaults in code otherwise).
BON_API_URL=https://api.bon.org.na/reporting
BON_LICENSE_NUMBER=PSP-2024-001
INSTITUTION_NAME=SmartPay Namibia
BON_CONTACT_NAME=Compliance Officer
BON_CONTACT_EMAIL=compliance@smartpay.na
BON_CONTACT_PHONE=+264811234567

# Compliance Alerts (Recipients)
COMPLIANCE_EMAIL=compliance@smartpay.na
CFO_EMAIL=cfo@smartpay.na
CEO_EMAIL=ceo@smartpay.na
CTO_EMAIL=cto@smartpay.na
OPERATIONS_EMAIL=ops@smartpay.na
COMPLIANCE_SMS=+264811234567

# Trust Account Configuration
TRUST_ACCOUNT_BANK=First National Bank Namibia
TRUST_ACCOUNT_NUMBER=62000000000
TRUST_ACCOUNT_BANK_CODE=FNB

# Slack/Webhook Integration (Optional)
SLACK_WEBHOOK_URL=

# Uptime Monitoring
API_BASE_URL=http://localhost:4000
UPTIME_CHECK_INTERVAL=60000

# Compliance Automation
ENABLE_COMPLIANCE_AUTOMATION=true
ENABLE_TRUST_RECONCILIATION=true
ENABLE_KRI_COLLECTION=true
ENABLE_UPTIME_MONITORING=true
ENABLE_BON_AUTO_REPORTING=true

# ============================================================================
# FEATURE FLAGS
# ============================================================================
ENABLE_VOUCHERS=true
ENABLE_LOANS=true
ENABLE_GROUPS=true
ENABLE_CASH_OUT=true
ENABLE_OBS=false
