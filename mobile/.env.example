# Buffr G2P Mobile – copy to .env or .env.local. Do not commit .env.
# EXPO_PUBLIC_* are embedded at build. Backend env: backend/.env.example and backend/docs.

# =============================================================================
# BACKEND API (required for real API)
# =============================================================================
# For iOS Simulator or physical device: use your computer's LAN IP, not localhost.
# Example: EXPO_PUBLIC_API_BASE_URL=http://192.168.11.17:3001
# Find IP: Mac = System Settings > Network; ensure backend is running (cd backend && npm run dev).
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_KETCHUP_API_URL=https://api.ketchup.cc
# Support / contact (e.g. ichigo@ketchup.cc)
EXPO_PUBLIC_KETCHUP_SUPPORT_EMAIL=
# Buffr AI Companion (Python server: backend, source ai/bin/activate, uvicorn --port 8000)
# Simulator: localhost:8000. Physical device: use your machine LAN IP, e.g. http://192.168.1.10:8000
EXPO_PUBLIC_BUFFR_AI_URL=http://localhost:8000
EXPO_PUBLIC_GATEWAY_URL=http://localhost:3001/api/gateway

# =============================================================================
# AUTH (Clerk – if used)
# =============================================================================
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# =============================================================================
# APP
# =============================================================================
APP_NAME=Buffr G2P Voucher Platform
APP_VERSION=2.0.18
APP_ENV=production
NODE_ENV=development

# =============================================================================
# BUFFR COMPANY (display – non-secret)
# =============================================================================
BUFFR_COMPANY_NAME=BUFFR FINANCIAL SERVICES CC
BUFFR_COMPANY_ID=CC/2024/09322
BUFFR_BANK_NAME=Bank Windhoek
BUFFR_ACCOUNT_NUMBER=8050377860
BUFFR_BRANCH_CODE=485-673
BUFFR_SWIFT_CODE=BWLINANX

# =============================================================================
# STACK AUTH (publishable only)
# =============================================================================
NEXT_PUBLIC_STACK_PROJECT_ID=
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=
NEON_AUTH_JWKS_URL=
NEXT_PUBLIC_APP_URL=https://pay.buffr.ai

# =============================================================================
# OPTIONAL
# =============================================================================
# EXPO_PUBLIC_APP_ENV=development

# Ketchup support / test account – set in .env only, never commit (see docs §8)
# KETCHUP_SUPPORT_PASSWORD=

# =============================================================================
# NAMQR CODE STANDARDS v5.0 (Bank of Namibia) – April 2025
# =============================================================================
# NAMQR Operator Configuration
EXPO_PUBLIC_NAMQR_OPERATOR_ID=na.com.namclear.namqr
EXPO_PUBLIC_NAMQR_VERSION=5.0

# Token Vault (for NAMQR validation)
EXPO_PUBLIC_TOKEN_VAULT_URL=https://tokenvault.na.namclear.na

# NAMQR Default Values
EXPO_PUBLIC_NAMQR_DEFAULT_COUNTRY_CODE=NA
EXPO_PUBLIC_NAMQR_DEFAULT_CURRENCY=516
EXPO_PUBLIC_NAMQR_DEFAULT_MCC=0000
EXPO_PUBLIC_NAMQR_EXPIRY_MINUTES=15

# NAMQR Supported Payment Streams
EXPO_PUBLIC_NAMQR_ENABLE_NRTC=true
EXPO_PUBLIC_NAMQR_ENABLE_ENCR=true
EXPO_PUBLIC_NAMQR_ENABLE_ENDO=true
EXPO_PUBLIC_NAMQR_ENABLE_IPP=true
EXPO_PUBLIC_NAMQR_ENABLE_POSD=true
EXPO_PUBLIC_NAMQR_ENABLE_POSC=true
EXPO_PUBLIC_NAMQR_ENABLE_ATM=true

# NAMQR Signed QR (ECDSA)
EXPO_PUBLIC_NAMQR_REQUIRE_SIGNATURE=false

# Buffr as Merchant
EXPO_PUBLIC_NAMQR_MERCHANT_ID=
EXPO_PUBLIC_NAMQR_MERCHANT_NAME=BUFFR FINANCIAL SERVICES CC
EXPO_PUBLIC_NAMQR_MERCHANT_CITY=Windhoek
EXPO_PUBLIC_NAMQR_MERCHANT_ONBOARDING_TYPE=BANK
