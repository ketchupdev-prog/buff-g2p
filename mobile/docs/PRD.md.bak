  modal: 40,
  toast: 50,
},

// Additional radius values
radius: {
  xs: 6,        // Seen in some chips
  '2xl': 24,    // Seen in bottom sheets
},

// Additional spacing
spacing: {
  scale: {
    '3xl': 40,  // Large hero spacing
    '4xl': 48,  // Screen padding
  },
},
```

