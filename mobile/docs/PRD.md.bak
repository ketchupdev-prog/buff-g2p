        <TouchableOpacity style={styles.primary} onPress={handleGoHome}>
          <Text style={styles.primaryText}>Go to Home</Text>
        </TouchableOpacity>
      </View>
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
